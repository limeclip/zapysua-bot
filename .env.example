BOT_TOKEN=your_telegram_bot_token
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
WEBHOOK_URL=https://your-vercel-app.vercel.app/api/webhook
WEBAPP_URL=https://your-vercel-app.vercel.app
NEXT_PUBLIC_BOT_USERNAME=ZapysUaBot

# AI-адміністратор (Етап 8)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Cron нагадування (див. docs/reminders.md)
CRON_SECRET=your_random_cron_secret
REMINDER_24H_ENABLED=true
REMINDER_2H_ENABLED=true
REMINDER_CRON_SCHEDULE="0 * * * *"
THANK_YOU_ENABLED=true
THANK_YOU_HOURS_AFTER=3
RETURN_CLIENTS_ENABLED=true
RETURN_DAYS=30

# Локальна розробка без Telegram (опційно):
# NEXT_PUBLIC_DEV_TELEGRAM_ID=123456789
